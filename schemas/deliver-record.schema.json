{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://serendizc.github.io/ai-coding-learning-loop/schemas/deliver-record.schema.json",
  "title": "AI Coding Learning Deliver Record",
  "type": "object",
  "required": ["schema_version", "work_unit_id", "implementation_ref", "verification_refs", "learning_targets", "topics_taught", "known_gaps", "ready_for_gate"],
  "properties": {
    "schema_version": { "const": "ai-coding-learning-loop.deliver.v1" },
    "work_unit_id": { "type": "string", "minLength": 1 },
    "implementation_ref": { "type": "string", "minLength": 1 },
    "verification_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "learning_targets": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "topics_taught": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "known_gaps": { "type": "array", "items": { "type": "string" } },
    "ready_for_gate": { "const": true }
  },
  "additionalProperties": true
}
