{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://serendizc.github.io/ai-coding-learning-loop/schemas/gate-case.schema.json",
  "title": "AI Coding Learning Gate Case",
  "type": "object",
  "required": ["schema_version", "id", "level", "learning_target_id", "deliver_topic", "deliver_ref", "prompt", "rubric"],
  "properties": {
    "schema_version": { "const": "ai-coding-learning-loop.gate-case.v1" },
    "level": { "enum": ["EXPLAIN", "PREDICT", "APPLY"] },
    "rubric": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  },
  "additionalProperties": true
}
